# ===================================================
# نِصاب — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وعبّئ القيم
# ===================================================

# --- Supabase — نسخة العميل (عامة، آمنة بالتصميم) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Supabase — نسخة الخادم (بلا بادئة VITE_، تُستخدم في requireSupabaseAuth ومسارات API) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...
# سرّي جداً — يتخطى RLS بالكامل، لا يُكشف للعميل أبداً. مطلوب لنقطة تحقق التقارير العامة.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Stripe للدفع (مطلوب للخطط المدفوعة) ---
STRIPE_SECRET_KEY=sk_live_...          # أو sk_test_... للاختبار
STRIPE_WEBHOOK_SECRET=whsec_...        # من لوحة Stripe > Webhooks
# Stripe Price IDs — أنشئها في لوحة Stripe > Products
STRIPE_PRICE_CERTIFIED=price_...
STRIPE_PRICE_VIP_ANNUAL=price_...
STRIPE_PRICE_STARTUP=price_...
STRIPE_PRICE_BUSINESS=price_...

# --- البريد الإلكتروني عبر Resend (مطلوب لإرسال التقارير) ---
# أضف في Supabase Dashboard > Edge Functions > Secrets
RESEND_API_KEY=re_...

# --- AI مستشار الزكاة (اختر مفتاحاً واحداً على الأقل) ---
LOVABLE_API_KEY=lvbl_...               # الأولوية الأولى (Gemini عبر Lovable)
OPENAI_API_KEY=sk-...                  # بديل: GPT-4o-mini
ANTHROPIC_API_KEY=sk-ant-...           # بديل: Claude Haiku

# --- بوابة المحاسب (مطلوب) ---
ACCOUNTANT_MASTER_PASSWORD=your_strong_password_here

# --- أسرار تصنعها أنت (32+ حرف عشوائي، مثال للتوليد:
#     bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# يحمي POST /api/public/hooks/hawl-reminders (ترويسة X-Cron-Secret)
CRON_SECRET=your_random_secret_here
# يحمي POST /api/public/erp/webhook (توقيع HMAC-SHA256) — مطلوب فقط لو فعّلت تكامل ERP خارجي
ERP_WEBHOOK_SECRET=your_random_secret_here

# --- عنوان الموقع (الدومين الفعلي المنشور — لا localhost في الإنتاج) ---
SITE_URL=http://localhost:8080

# --- Sentry (اختياري لمراقبة الأخطاء — بدونه Sentry معطَّل بصمت بلا خطأ) ---
VITE_SENTRY_DSN=https://...@sentry.io/...

# --- خصم Early-Bird التسويقي (اختياري، YYYY-MM-DD) ---
VITE_EARLY_BIRD_UNTIL=2026-12-31
