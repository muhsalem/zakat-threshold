{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "نِصاب",
  "version": "0.1.0",
  "identifier": "com.nisab.desktop",
  "build": {
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "",
    "frontendDist": "https://REPLACE-WITH-YOUR-DEPLOYED-DOMAIN.example"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "نِصاب — منصة الزكاة",
        "url": "https://REPLACE-WITH-YOUR-DEPLOYED-DOMAIN.example",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
